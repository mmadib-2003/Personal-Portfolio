# Required — Supabase (public read path, safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — bypasses RLS. Used by the contact Server Action and never
# imported into a Client Component (guarded by `server-only`).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — raises the GitHub API rate limit for the agent's repo tool.
# Unauthenticated public calls still work (60 req/h vs 5,000 req/h).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Required for the AI chat widget. Vercel AI Gateway key.
# On a Vercel deployment you may omit this: Vercel OIDC is used automatically.
AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxxxxxxxxx

# Optional — override the model routed through the Gateway.
AI_MODEL_ID=openai/gpt-4o-mini

# Optional — only for local development against a mock Gateway
# (see scripts/mock-gateway.mjs). Never set this on Vercel.
# AI_GATEWAY_BASE_URL=http://127.0.0.1:4010

# Optional — canonical origin used in metadata, sitemap.xml and robots.txt.
# Defaults to https://muntasir-adib-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=https://muntasir-adib-portfolio.vercel.app
